# ── ApiPatch — .env.example ───────────────────────────────────────────────────
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# NEVER commit .env to version control (it is already in .gitignore)
# ─────────────────────────────────────────────────────────────────────────────

# ── AI Provider (choose one) ──────────────────────────────────────────────────
# Get a free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI: https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# Anthropic Claude: https://console.anthropic.com/
# ANTHROPIC_API_KEY=

# ── GitHub ────────────────────────────────────────────────────────────────────
# Personal Access Token with repo + pull_request scopes
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Webhook HMAC secret (set the same value in your GitHub App/Webhook settings)
GITHUB_WEBHOOK_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────────
# Set to 1 to opt out of anonymous usage telemetry
# APIPATCH_NO_TELEMETRY=1
